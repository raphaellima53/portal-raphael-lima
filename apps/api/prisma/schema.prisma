// Banco do Portal Raphael Lima.
// Espelha as bases do artefato "01. Portal Raphael Lima.html": cadastros (DB, CAD, CUR, EMP), usuários e personas
// de teste, ajustes de aula (AG_OV) e configurações por usuário que lá ficavam no localStorage.
// O portal junta professor, curso e sala pelo nome; aqui cada um tem id, e o carregador da base (src/domain/base.ts)
// devolve os nomes para as regras portadas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- acesso

/// Conta de acesso. Personas de teste têm `personaLetra`; os demais usuários vêm da base antiga (AC.usuarios).
model Usuario {
  id             Int       @id @default(autoincrement())
  nome           String
  email          String    @unique
  senhaHash      String?
  /// Senha à mostra na tela de login, só das personas de teste (ambiente de teste)
  senhaTeste     String?
  /// ID_perfil de acesso.ts (1 Admin … 16 Gerente B2B). Nulo nos usuários da base antiga.
  perfilId       Int?
  /// Hierarquia: 1 Administrador · 2 Gestor · 3 Editor · 4 Colaborador · 5 Visualizador
  nivel          Int       @default(5)
  /// { [setor]: { acesso: 'total' | 'restrito' | 'proprio', rotulo } }
  areas          Json      @default("{}")
  status         String    @default("Ativo")
  mfa            Boolean   @default(false)
  perfilLegado   String?
  escopoLegado   String?
  ultimoAcesso   String?
  personaLetra   String?   @unique
  personaTipo    String?
  personaCursos  String[]
  personaModulos String[]
  objetivo       String?
  /// Filtros presos na agenda (a Professora só vê a própria agenda)
  agendaPresa    Json?
  alunoId        Int?      @unique
  aluno          Aluno?    @relation(fields: [alunoId], references: [id])
  ordem          Int       @default(0)
  /// Novo usuário (Configurações › Usuários): pessoa de origem, vínculo, contato, prazo, quem responde e por quê
  pessoa         String?
  colaborador    String?
  telefone       String?
  validoAte      DateTime? @db.Date
  responsavel    String?
  justificativa  String?
  observacoes    String?
  /// { convite, mfa, mfaExcluir, ip, expira }
  seguranca      Json?
  /// foto do perfil (endereço da imagem)
  foto           String?
  /// obriga a trocar a senha no próximo login
  trocarSenha    Boolean   @default(false)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  sessoes      Sessao[]
  dashboard    DashboardConfig?
  preferencias Preferencia[]
  emails       UsuarioEmail[]
  telefones    UsuarioTelefone[]
  enderecos    UsuarioEndereco[]
  notificacoes Notificacao[]
}

/// E-mails da conta: vários, um principal (o principal espelha Usuario.email)
model UsuarioEmail {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  email     String
  principal Boolean @default(false)

  @@unique([usuarioId, email])
}

/// Telefones da conta: vários, um principal (o principal espelha Usuario.telefone)
model UsuarioTelefone {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  telefone  String
  principal Boolean @default(false)

  @@index([usuarioId])
}

/// Endereços da conta: vários, um principal
model UsuarioEndereco {
  id          Int     @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cep         String  @default("")
  rua         String  @default("")
  numero      String  @default("")
  complemento String  @default("")
  bairro      String  @default("")
  cidade      String  @default("")
  uf          String  @default("")
  principal   Boolean @default(false)

  @@index([usuarioId])
}

/// Alertas guardados por usuário (1. Alertas do rodapé): o que já foi lido some do contador
model Notificacao {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  texto     String    @default("")
  link      String?
  criadaEm  DateTime  @default(now())
  lidaEm    DateTime?

  @@index([usuarioId, lidaEm])
}

model Sessao {
  /// sha256 do token do cookie
  id           String    @id
  usuarioId    Int
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadaEm     DateTime  @default(now())
  expiraEm     DateTime
  encerradaEm  DateTime?
  ip           String?
  userAgent    String?
  /// Acessar como: a sessão mostra o portal como este aluno até Voltar ao portal
  comoAlunoId  Int?
  /// Acessar como um professor: a sessão vira Prestador com a agenda presa nele
  comoProfId   String?
  /// tela de onde saiu o Acessar como
  comoVolta    String?
  /// última requisição da sessão (Sessões e acessos)
  vistaEm      DateTime  @default(now())
  /// quem encerrou pela tela Sessões e acessos
  encerradaPor String?

  @@index([usuarioId])
}

/// Blocos escolhidos no Personalizar do Dashboard (no portal: localStorage alumni.dashboard.<login>)
model DashboardConfig {
  usuarioId Int      @id
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  blocos    String[]
  salvoEm   DateTime @default(now())
}

/// Preferências por usuário (layout da agenda etc.)
model Preferencia {
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chave     String
  valor     Json
  salvoEm   DateTime @default(now()) @updatedAt

  @@id([usuarioId, chave])
}

// ---------------------------------------------------------------- catálogos e pessoas

/// Os seis catálogos de Configurações: tipos de curso, idiomas, skills, tipos de sala, gêneros e responsáveis financeiros.
model Catalogo {
  id    Int     @id @default(autoincrement())
  tipo  String
  nome  String
  ativo Boolean @default(true)
  dados Json?
  ordem Int     @default(0)

  @@unique([tipo, nome])
}

model Departamento {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String  @default("")
  ativo     Boolean @default(true)
  ordem     Int     @default(0)
}

model Cargo {
  id           Int     @id @default(autoincrement())
  nome         String  @unique
  departamento String
  descricao    String  @default("")
  ativo        Boolean @default(true)
  ordem        Int     @default(0)
}

/// Time interno (CAD.employees)
model Colaborador {
  id           Int       @id @default(autoincrement())
  nome         String
  email        String    @unique
  departamento String
  cargo        String
  cpf          String    @default("")
  telefone     String    @default("")
  nascimento   DateTime? @db.Date
  admissao     DateTime? @db.Date
  genero       String?
  /// { cep, rua, numero, complemento, bairro, cidade, uf }
  endereco     Json?
  ativo        Boolean   @default(true)
  ordem        Int       @default(0)
}

model Segmento {
  id   Int    @id @default(autoincrement())
  nome String @unique
}

/// Contas B2B e B2B2C (EMP), com o representante do cadastro (CAD.companies)
model Empresa {
  id             String    @id
  nome           String    @unique
  cnpj           String
  segmento       String
  modelo         String
  gerente        String
  representante  String?
  funcionarios   Int?
  /// { cep, rua, numero, complemento, bairro, cidade, uf }
  endereco       Json?
  rhNome         String
  rhEmail        String
  rhDepartamento String    @default("")
  rhTelefone     String    @default("")
  inicio         DateTime  @db.Date
  fim            DateTime  @db.Date
  licencas       Int
  aulas          Int
  valor          Decimal   @db.Decimal(12, 2)
  subsidio       Int
  desconto       Int
  renovaAuto     Boolean
  turmaCurso     String?
  cursos         String[]
  ativo          Boolean   @default(true)
  ordem          Int       @default(0)
  /// último relatório mandado ao RH
  relEm          DateTime?

  alunos Aluno[]
  turmas Turma[]
}

// ---------------------------------------------------------------- cursos, professores e salas

model Curso {
  id                 Int     @id @default(autoincrement())
  nome               String  @unique
  cor                String
  /// modulos · turmas · nenhuma
  estrutura          String
  formato            String
  tipo               String
  idioma             String
  ativo              Boolean @default(true)
  autoAgenda         Boolean @default(false)
  descricao          String  @default("")
  /// { vagas, duracao, modalidades, pacote, cancelamento, antecedencia?, exigeDisp, valorAula? } (cancelamento e antecedencia em horas)
  regras             Json
  /// sigla curta (ex.: ESS1)
  sigla              String  @default("")
  /// natureza do produto (Curso · Serviço · Assinatura)
  natureza           String  @default("Curso")
  /// catálogo Visibilidades de oferta
  visibilidadeOferta String  @default("")
  /// catálogo Tipos de sala
  tipoSala           String  @default("")
  /// { entradaAgenda, professor, agendaPor, credito, congela, gereMatricula, presenca, onboarding }
  configAgenda       Json?
  ordem              Int     @default(0)

  modulos    Modulo[]
  turmas     Turma[]
  matriculas Matricula[]
  ofertas    Oferta[]
  servicos   Servico[]
  ciclos     CicloAprendizagem[]
}

model Modulo {
  id        Int    @id @default(autoincrement())
  cursoId   Int
  curso     Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nome      String
  cor       String
  sigla     String @default("")
  descricao String @default("")
  /// vagas por aula em grupo; nulo = as do curso
  vagas     Int?
  ordem     Int    @default(0)

  @@unique([cursoId, nome])
}

/// Turma dedicada (FAAP, Palmares): a turma ocupa o lugar do módulo
model Turma {
  id          Int        @id @default(autoincrement())
  cursoId     Int
  curso       Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nome        String
  grupo       String
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id])
  /// "Seg e Qua · 08:00"
  grade       String
  vagas       Int
  ocupadas    Int
  sala        String
  modalidade  String
  periodo     String
  curriculo   String
  /// início e fim da turma; nulo = em aberto
  inicio      DateTime?  @db.Date
  fim         DateTime?  @db.Date
  ativa       Boolean    @default(true)
  /// turma dedicada de uma empresa (organização)
  empresaId   String?
  empresa     Empresa?   @relation(fields: [empresaId], references: [id])
  ordem       Int        @default(0)

  @@unique([cursoId, nome])
}

model Professor {
  id              String    @id
  nome            String    @unique
  email           String
  /// nomes dos cursos em que está habilitado
  cursos          String[]
  /// recorte da habilitação por curso: { [curso]: [módulos ou turmas] }
  habilitacao     Json?
  carga           Int       @default(3)
  teto            Int       @default(24)
  ativo           Boolean   @default(true)
  valorHora       Decimal?  @db.Decimal(10, 2)
  /// "dia-hora" marcados; nulo = nasce da grade
  disponibilidade String[]
  dispDefinida    Boolean   @default(false)
  cpf             String    @default("")
  telefone        String    @default("")
  nascimento      DateTime? @db.Date
  genero          String?
  /// { cep, rua, numero, complemento, bairro, cidade, uf }
  endereco        Json?
  /// catálogo Skills dos professores
  skills          String[]
  ordem           Int       @default(0)

  turmas     Turma[]
  avaliacoes AvaliacaoProfessor[]
  ausencias  AusenciaProfessor[]
  pedidos    PedidoCancelamentoAlocacao[]
  sessoes    SessaoPedagogica[]
  extratos   ExtratoProfessor[]
}

/// Férias, licenças e faltas planejadas (Professores › ficha › Ausências)
model AusenciaProfessor {
  id          Int       @id @default(autoincrement())
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  inicio      DateTime  @db.Date
  fim         DateTime  @db.Date
  motivo      String    @default("")
  criadoPor   String    @default("")
  criadoEm    DateTime  @default(now())

  @@index([professorId])
}

/// O professor pede para largar uma alocação fixa; a coordenação decide
model PedidoCancelamentoAlocacao {
  id          Int       @id @default(autoincrement())
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  /// aluno e curso da alocação (matrícula) ou turma
  alvo        String
  motivo      String    @default("")
  /// Pendente · Aprovado · Recusado
  status      String    @default("Pendente")
  decididoPor String?
  decididoEm  DateTime?
  criadoEm    DateTime  @default(now())

  @@index([professorId])
}

/// Sessão pedagógica: observação de aula e devolutiva ao professor
model SessaoPedagogica {
  id          Int       @id @default(autoincrement())
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  data        DateTime  @db.Date
  avaliador   String
  /// 1 a 5
  nota        Int?
  observacoes String    @default("")
  criadoEm    DateTime  @default(now())

  @@index([professorId])
}

/// Extrato mensal do professor: aulas do mês viram valor; fecha, recebe nota fiscal e é pago
model ExtratoProfessor {
  id          Int       @id @default(autoincrement())
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  /// AAAA-MM
  mes         String
  /// Aberto · Fechado · Pago
  estado      String    @default("Aberto")
  notaFiscal  String    @default("")
  fechadoEm   DateTime?
  pagoEm      DateTime? @db.Date
  observacoes String    @default("")

  lancamentos LancamentoExtrato[]

  @@unique([professorId, mes])
}

/// Acertos manuais do extrato (bônus, desconto, reembolso)
model LancamentoExtrato {
  id        Int              @id @default(autoincrement())
  extratoId Int
  extrato   ExtratoProfessor @relation(fields: [extratoId], references: [id], onDelete: Cascade)
  descricao String
  valor     Decimal          @db.Decimal(10, 2)
  /// Crédito · Débito
  tipo      String           @default("Crédito")
  cancelado Boolean          @default(false)
  criadoPor String           @default("")
  criadoEm  DateTime         @default(now())

  @@index([extratoId])
}

/// Avaliações registradas no portal (Professores › ficha › Feedbacks); as dos alunos presentes são lidas da agenda
model AvaliacaoProfessor {
  id          Int       @id @default(autoincrement())
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  quando      DateTime  @default(now())
  aluno       String
  curso       String
  aula        String
  nota        Int
  texto       String
  por         String

  @@index([professorId])
}

model Sala {
  id             Int       @id @default(autoincrement())
  nome           String    @unique
  atende         String
  tipo           String
  zoom           Boolean   @default(false)
  /// conta do Zoom da sala e até quando a licença vale
  zoomEmail      String    @default("")
  zoomLicencaAte DateTime? @db.Date
  ativo          Boolean   @default(true)
  ordem          Int       @default(0)
}

model Feriado {
  id     Int      @id @default(autoincrement())
  data   DateTime @unique @db.Date
  nome   String
  origem String
}

/// Dias e horários de funcionamento (0 = domingo)
model Funcionamento {
  dia    Int     @id
  nome   String
  aberto Boolean
  inicio String
  fim    String
}

// ---------------------------------------------------------------- alunos

model Aluno {
  id                    Int       @id @default(autoincrement())
  nome                  String
  email                 String
  cpf                   String
  emailPlaceholder      Boolean   @default(false)
  /// Ativo · Suspenso · Congelado · Inadimplente · Cancelado · Inativo
  status                String    @default("Ativo")
  desativadoEm          DateTime?
  empresaId             String?
  empresa               Empresa?  @relation(fields: [empresaId], references: [id])
  contratoFim           DateTime? @db.Date
  disponibilidade       String[]
  dispDefinida          Boolean   @default(false)
  /// situação de antes do Desativar, para o Reativar devolver
  statusAntes           String?
  /// posição na lista: aluno novo entra no topo
  ordem                 Int       @default(0)
  /// os feedbacks de exemplo nascem na primeira leitura da ficha (fbAluno do portal)
  fbGerado              Boolean   @default(false)
  telefone              String    @default("")
  nascimento            DateTime? @db.Date
  /// catálogo Gêneros
  genero                String?
  /// { cep, rua, numero, complemento, bairro, cidade, uf }
  endereco              Json?
  /// catálogo Responsáveis financeiros
  responsavelFinanceiro String?
  /// sistema de onde o cadastro veio (importação)
  origemExterna         String?
  criadoEm              DateTime  @default(now())

  matriculas      Matricula[]
  usuario         Usuario?
  feedbacks       FeedbackAluno[]
  datasBloqueadas DataBloqueada[]
  feedbacksAula   FeedbackAula[]
}

/// Dias em que o aluno não pode ter aula (viagem, prova): a alocação e o agendamento pulam essas datas
model DataBloqueada {
  id       Int      @id @default(autoincrement())
  alunoId  Int
  aluno    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  data     DateTime @db.Date
  motivo   String   @default("")
  criadoEm DateTime @default(now())

  @@unique([alunoId, data])
}

/// Feedback que o aluno dá sobre uma aula (notas de 1 a 5)
model FeedbackAula {
  id              Int      @id @default(autoincrement())
  alunoId         Int
  aluno           Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  /// chave da aula (curso|módulo|quem|AAAA-MM-DD|hora), a mesma de AulaAjuste
  aulaChave       String
  curso           String
  professor       String   @default("")
  estadoEmocional Int
  clareza         Int
  participacao    Int
  aprendizado     Int
  observacoes     String   @default("")
  criadoEm        DateTime @default(now())

  @@unique([alunoId, aulaChave])
}

/// Feedbacks e ocorrências de qualidade do aluno (Alunos › ficha › Feedbacks)
model FeedbackAluno {
  id      Int      @id @default(autoincrement())
  alunoId Int
  aluno   Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  quando  DateTime
  /// Reclamação · Elogio · Sugestão · Qualidade
  tipo    String
  area    String
  curso   String
  canal   String
  texto   String
  /// Aberto · Em tratativa · Concluído
  status  String
  por     String
  anexos  Anexo[]

  @@index([alunoId])
}

/// Prints e documentos anexados a um feedback (até 10 MB cada)
model Anexo {
  id         Int           @id @default(autoincrement())
  feedbackId Int
  feedback   FeedbackAluno @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String
  tam        Int
  dados      Bytes
  criadoEm   DateTime      @default(now())

  @@index([feedbackId])
}

model Matricula {
  id           Int       @id @default(autoincrement())
  alunoId      Int
  aluno        Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  cursoId      Int
  curso        Curso     @relation(fields: [cursoId], references: [id])
  /// módulo ou turma atual (nome); nulo no produto sem subdivisão (Alumni Black)
  modulo       String?
  usadas       Int
  total        Int
  modalidade   String    @default("Online")
  desativadoEm DateTime?
  /// alocação da aula individual: { prof, dias, hora, valor }
  alocacao     Json?
  /// vigência do contrato da matrícula
  inicio       DateTime? @db.Date
  fim          DateTime? @db.Date
  /// Regular · Bolsa · Cortesia · Reposição · Teste
  statusTipo   String    @default("Regular")
  /// congelada desde (nulo = não congelada)
  congeladaEm  DateTime?
  /// Venda · Renovação · Importação · Empresa
  origem       String    @default("Venda")
  /// proposta comercial que gerou a matrícula
  ofertaId     String?
  oferta       Oferta?   @relation(fields: [ofertaId], references: [id])
  /// matrícula ligada (ex.: o Black ligado ao curso principal)
  vinculadaId  Int?
  ordem        Int       @default(0)

  nivelamento Nivelamento?
  relatorios  RelatorioMatricula[]

  @@index([alunoId])
}

/// Resultado do nivelamento (leveling) que abre a matrícula
model Nivelamento {
  id          Int       @id @default(autoincrement())
  matriculaId Int       @unique
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  /// A0 · A1 · A1+ · A2 · A2+ · B1 · B1+ · B2 · B2+ · C1
  cefr        String
  nota        Int?
  concluidoEm DateTime? @db.Date
  codigo      String    @default("")
}

/// Proposta comercial (oferta): o que foi vendido, por quanto e para quem
model Oferta {
  id            String    @id
  nome          String
  codigo        String    @unique
  cursoId       Int
  curso         Curso     @relation(fields: [cursoId], references: [id])
  /// pacote de aulas
  pacote        Int
  preco         Decimal   @db.Decimal(12, 2)
  parcelas      Int       @default(1)
  /// duração em meses e carga horária total
  duracao       Int?
  cargaHoraria  Int?
  /// negócio no CRM
  negocioId     String    @default("")
  /// Aberto · Ganho · Perdido
  negocioStatus String    @default("Aberto")
  negocioData   DateTime?
  beneficiario  String
  pessoaFisica  Boolean   @default(true)
  /// Aberta · Vinculada · Descartada
  situacao      String    @default("Aberta")
  criadoEm      DateTime  @default(now())

  matriculas Matricula[]
}

/// Relatório de acompanhamento da matrícula (para o aluno ou o RH)
model RelatorioMatricula {
  id          Int       @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  /// período coberto (AAAA-MM)
  periodo     String
  texto       String
  /// Rascunho · Enviado · Silenciado
  status      String    @default("Rascunho")
  enviadoEm   DateTime?
  por         String
  criadoEm    DateTime  @default(now())

  @@index([matriculaId])
}

// ---------------------------------------------------------------- currículo e agenda

model Curriculo {
  id        String   @id
  nome      String
  grupo     String
  /// produto · acervo
  tipo      String
  idioma    String
  aplicado  String[]
  /// catálogo Categorias de currículo
  categoria String   @default("")
  /// [[versão, situação, data, conteúdos]]
  versoes   Json
  /// conteúdos da versão publicada
  conteudos Json
  ordem     Int      @default(0)
}

/// Acervo de conteúdos (links, arquivos e pacotes SCORM) usados nas aulas dos currículos
model Conteudo {
  id       Int      @id @default(autoincrement())
  nome     String
  url      String   @default("")
  /// catálogos Tipos de conteúdo e Fontes
  tipo     String
  fonte    String   @default("")
  idioma   String   @default("")
  /// momento da aula: Pré-aula · Aula · Pós-aula
  momento  String   @default("Aula")
  /// pacote SCORM (identificador do pacote)
  scorm    String   @default("")
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
}

/// Serviços (atendimento, acompanhamento, consultoria): ficam ao lado dos cursos
model Servico {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  sigla     String  @default("")
  cor       String  @default("#003FB0")
  descricao String  @default("")
  /// catálogo Categorias de serviço
  categoria String  @default("")
  vagas     Int     @default(1)
  /// curso ao qual o serviço se liga (opcional)
  cursoId   Int?
  curso     Curso?  @relation(fields: [cursoId], references: [id])
  ativo     Boolean @default(true)
  ordem     Int     @default(0)
}

/// Calendário letivo: período em que os ciclos geram aulas
model Calendario {
  id     Int      @id @default(autoincrement())
  nome   String   @unique
  inicio DateTime @db.Date
  fim    DateTime @db.Date
  ativo  Boolean  @default(true)

  ciclos CicloAprendizagem[]
}

/// Ciclo de aprendizagem: como o currículo de um curso vira aulas num calendário
model CicloAprendizagem {
  id           Int         @id @default(autoincrement())
  nome         String
  cursoId      Int
  curso        Curso       @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  calendarioId Int?
  calendario   Calendario? @relation(fields: [calendarioId], references: [id])
  /// catálogos Progressões e Tipos de geração
  progressao   String      @default("")
  tipoGeracao  String      @default("")
  /// ciclo em que o aluno novo entra
  nascimento   Boolean     @default(false)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now())

  @@unique([cursoId, nome])
}

/// O que se muda numa aula específica (AG_OV): professor, cancelamento, presença, conclusão…
/// chave = curso|módulo|quem|AAAA-MM-DD|hora
model AulaAjuste {
  chave        String   @id
  dados        Json
  atualizadoEm DateTime @default(now()) @updatedAt
}

/// Histórico de alterações (FX_LOG + histórico da base)
model LogAlteracao {
  id         Int      @id @default(autoincrement())
  quando     DateTime @default(now())
  autor      String
  entidade   String
  entidadeId String?
  nome       String
  acao       String
  detalhe    String?
  /// cliques seguidos na mesma ação viram uma linha só
  vezes      Int      @default(1)
  origem     String   @default("portal")
  /// valores antes e depois da alteração, quando a tela manda
  antes      Json?
  depois     Json?
  /// motivo informado por quem alterou
  motivo     String?

  @@index([quando])
}

/// Eventos e reuniões da Agenda (AG_EVENTOS). participantes: [{ g: colaborador|prestador|aluno, n }]
model Evento {
  id            String   @id
  tipo          String
  titulo        String
  inicio        DateTime
  fim           DateTime
  local         String   @default("")
  descricao     String   @default("")
  participantes Json
  criadoPor     String
  exemplo       Boolean  @default(false)
  criadoEm      DateTime @default(now())

  @@index([inicio])
}

/// Competência fechada no Fechamento (FEC_ESTADO). ym = AAAA-MM
model FechamentoCompetencia {
  ym     String   @id
  por    String
  quando DateTime @default(now())
  dados  Json
}

// ---------------------------------------------------------------- ações

/// Leads do Funil de vendas (Ações › Comercial)
model Lead {
  id         String   @id
  nome       String
  email      String
  origem     String
  curso      String
  consultor  String
  /// captado · contato · nivelamento · proposta · matriculado · perdido
  etapa      String
  /// etapa de antes de perder, para o Reabrir
  etapaAntes String?
  motivo     String   @default("")
  alunoId    Int?
  entrou     DateTime
  mudou      DateTime
  ordem      Int      @default(0)
}

/// Parcela registrada como paga (no portal: FIN_PAGOS)
model ParcelaPaga {
  chave  String   @id
  quando DateTime @default(now())
  por    String
}

/// Cards dos fluxos com kanban (Substituição, Mudança de nível, Reposição, Admissão, Cobrança, Renovação, Campanhas, Retenção)
model FluxoCard {
  id      String   @id
  fluxo   String
  etapa   String
  valores Json
  criado  DateTime @default(now())
  mudou   DateTime @default(now())
  quem    String
  /// [{ de, para, quem, quando, nota }]
  hist    Json     @default("[]")

  @@index([fluxo])
}

/// Fluxo que já recebeu a carga inicial lida da base
model FluxoSemeado {
  fluxo  String   @id
  quando DateTime @default(now())
}

// ---------------------------------------------------------------- configurações

/// Histórico de acesso (Sessões e acessos): login, logout, recusa, logout forçado, perfil alterado
model AcessoLog {
  id        Int      @id @default(autoincrement())
  quando    DateTime @default(now())
  quem      String
  evento    String
  resultado String
  detalhe   String   @default("")

  @@index([quando])
}

/// Regras salvas nas telas de Configurações (condições e vigência, políticas de acesso, alertas)
model Configuracao {
  chave   String   @id
  valor   Json
  salvoEm DateTime @default(now()) @updatedAt
  por     String   @default("")
}

// ---------------------------------------------------------------- engenharia

/// Análise de saúde de um repositório do GitHub (Engenharia › Repositórios): os 16 critérios e a nota
model AnaliseRepo {
  id      Int      @id @default(autoincrement())
  dono    String
  repo    String
  quando  DateTime @default(now())
  nota    Int
  selo    String
  tom     String
  ok      Int
  atencao Int
  falha   Int
  /// [{ k, t, d, peso, nivel, detalhe }]
  itens   Json
  por     String

  @@index([dono, repo, quando])
}

/// Catálogo de atividades (lista de 23/09/2026): a cadência diz se o cartão nasce sozinho (diaria…trimestral),
/// se entra quando alguém cria (eventual) ou se é um projeto de uma vez só (projeto)
model AtividadeModelo {
  id          Int         @id @default(autoincrement())
  nome        String
  descricao   String      @default("")
  /// diaria · semanal · quinzenal · mensal · bimestral · trimestral · eventual · projeto
  cadencia    String
  setor       String
  tipo        String
  /// responsável padrão dos cartões que nascem deste modelo
  responsavel String      @default("")
  prioridade  String      @default("Média")
  ativo       Boolean     @default(true)
  criado      DateTime    @default(now())
  atividades  Atividade[]
}

/// Cartão de Atividades (Comercial ou Operações, pela frente do setor)
model Atividade {
  id          Int              @id @default(autoincrement())
  titulo      String
  descricao   String           @default("")
  setor       String
  tipo        String
  responsavel String           @default("")
  prioridade  String           @default("Média")
  prazo       DateTime?
  /// afazer · andamento · concluida · cancelada · expirada (recorrente que o período seguinte substituiu)
  situacao    String           @default("afazer")
  /// com quem: aluno · empresa · professor · lead
  relTipo     String?
  relId       String?
  relNome     String?
  modeloId    Int?
  modelo      AtividadeModelo? @relation(fields: [modeloId], references: [id])
  /// período do cartão recorrente (2026-09-23, 2026-S39, 2026-09-Q2, 2026-09…); um cartão por modelo e período
  periodo     String?
  criado      DateTime         @default(now())
  criadoPor   String
  concluida   DateTime?
  /// [{ quando, quem, acao, det }]
  hist        Json             @default("[]")

  @@unique([modeloId, periodo])
  @@index([setor, situacao])
}

/**
 * ================= Deal dentro do Portal (23/09/2026; protótipo 23, deal.src.js) =================
 * Cliente = Aluno ou Empresa do Portal. As parcelas dos pedidos que vieram das matrículas são as do Portal
 * (finCobrancas, chave "alunoId|curso" ou "turma|curso"); os pedidos novos têm as próprias (ParcelaPedido).
 * Presets e formas de pagamento são regra do código (domain/deal.ts).
 */

/// Oferta padrão: o pacote que o comercial vende (não confundir com Oferta, a proposta do CRM por pessoa)
model OfertaPadrao {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nome        String
  curso       String
  aulas       Int
  meses       Int
  preco       Decimal  @db.Decimal(12, 2)
  parcelasMax Int
  recorrente  Boolean  @default(false)
  /// 1 Integral · Cartão · 2 Recorrência · Cartão · 3 Parcelado · Pix/Boleto · 4 Faturado · Boleto contra NF
  forma       Int
  faturamento String
  /// B2C · B2B2C · B2B
  mercado     String
  nicho       String
  planoVindi  String   @default("")
  ativa       Boolean  @default(true)
  /// [{ tipologia, produto, curso }]
  itens       Json     @default("[]")
  criada      DateTime @default(now())
}

/// Contrato empresarial (B2B2C benefício ou B2B turma dedicada)
model ContratoEmpresa {
  id        Int      @id @default(autoincrement())
  nome      String
  /// nome da empresa (ou do curso de turma dedicada) e o id da Empresa quando houver
  empresa   String
  empresaId String?
  cnpj      String
  preset    String
  tipoB2B   String
  inicio    DateTime
  fim       DateTime
  /// Ativo · Encerrado
  status    String   @default("Ativo")
  motivoFim String   @default("")
  max       Int
  /// ids dos alunos beneficiários
  benef     Int[]
  kam       String
  retencao  String
  /// ids das ofertas padrão
  ofertas   Int[]
  turmas    String[]
  /// [{ quando, quem, acao, det }]
  hist      Json     @default("[]")
}

/// Pedido (venda) do Deal
model Pedido {
  id           Int      @id @default(autoincrement())
  data         DateTime
  alunoId      Int?
  cliente      String
  curso        String
  ofertaId     Int?
  ofertaNome   String
  total        Decimal  @db.Decimal(12, 2)
  forma        Int
  parcelas     Int
  preset       String
  /// B2C · B2B2C · B2B
  tipo         String
  contratoId   Int?
  vendedor     String
  renovacao    Boolean  @default(false)
  cancelado    Boolean  @default(false)
  motivoCancel String   @default("")
  cupom        String   @default("")
  desconto     Decimal  @default(0) @db.Decimal(12, 2)
  /// prefixo das parcelas do Portal ("12|Alumni Black", "turma|FAAP") ou "novo|id" (ParcelaPedido)
  chave        String
  obs          String   @default("")
  hist         Json     @default("[]")

  @@index([alunoId])
}

/// Parcela de pedido criado pelo Novo pedido
model ParcelaPedido {
  chave    String    @id
  pedidoId Int
  n        Int
  de       Int
  venc     DateTime
  valor    Decimal   @db.Decimal(12, 2)
  pago     DateTime?

  @@index([pedidoId])
}

/// Ordem de faturamento de contrato B2B por competência
model OrdemFaturamento {
  id          Int       @id @default(autoincrement())
  numero      String    @default("")
  /// AAAA-MM
  competencia String
  /// a confirmar · proposta · liberada
  status      String
  contratoId  Int
  pagador     String
  linhas      Int
  total       Decimal   @db.Decimal(12, 2)
  venc        DateTime
  turmas      String[]
  liberadaEm  DateTime?
}

/// Nota fiscal autorizada (a fila é calculada: parcela paga ou ordem liberada sem nota)
model NotaFiscal {
  id          Int      @id @default(autoincrement())
  numero      String
  total       Decimal  @db.Decimal(12, 2)
  competencia String
  emitida     DateTime
  pagador     String
  alunoId     Int?
  pedidoId    Int?
  ordemId     Int?
  parcela     String   @default("—")
  /// chave da parcela (aluno) — uma nota por parcela
  chave       String?  @unique
  /// Aluno · Empresa
  escopo      String
}

model Cupom {
  codigo    String   @id
  descricao String
  /// % ou R$
  tipo      String
  valor     Decimal  @db.Decimal(12, 2)
  validade  DateTime
  limite    Int
  ofertas   Int[]
  criado    DateTime @default(now())
}

model Bolsa {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  nome      String
  /// Social · Operacional
  caso      String
  curso     String
  inicio    DateTime
  fim       DateTime
  aulas     Int
  usadas    Int
  custo     Decimal  @db.Decimal(12, 2)
  motivo    String
  concedida DateTime @default(now())
}

/// Fila de importação da Vindi: cobranças que chegaram e ainda não viraram venda, baixa ou estorno
model ImportacaoVindi {
  id           String    @id
  /// vendas · cobrancas · estornos
  aba          String
  nome         String
  valor        Decimal   @db.Decimal(12, 2)
  quando       DateTime
  oferta       String
  critica      String    @default("")
  pronta       Boolean
  acao         String
  importadaEm  DateTime?
  importadaPor String?
}

/// Carga inicial do Deal já feita (uma vez por banco)
model DealCarga {
  chave  String   @id
  quando DateTime @default(now())
}
