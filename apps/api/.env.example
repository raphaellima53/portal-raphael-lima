# Banco (docker compose da raiz ou `pnpm db:local`)
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal"
# Supabase (painel > Connect): DATABASE_URL = "Session pooler" (porta 5432 do host *.pooler.supabase.com),
# com ?sslmode=require&uselibpqcompat=true no fim. DIRECT_URL é opcional e só vale para as migrações.
# DIRECT_URL=""

# Servidor
PORT=3333
HOST=0.0.0.0
WEB_ORIGIN="http://localhost:3000"
# O portal lê horários no fuso da escola
TZ="America/Sao_Paulo"
COOKIE_SECRET="troque-por-um-segredo-longo"
SESSION_DAYS=7

# GitHub (lista de repositórios e análise de saúde)
GITHUB_TOKEN=""
GITHUB_OWNER=""

# IA — três provedores via fetch
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
